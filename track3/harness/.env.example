# Copy to track3/.env (or export in your shell) before using --agent llm.
# Never commit a real .env -- this file only documents the variable names.
#
# The dumb agent (--agent dumb, the default) needs NONE of these -- it makes zero
# network calls to any model provider, by construction.

# OpenRouter (primary LLM path, see harness/llm_agent.py)
OPENROUTER_API_KEY=

# Gemini free tier (cheap iteration / fallback)
GEMINI_API_KEY=

# Optional: default model string passed to --model when omitted on the CLI.
# Examples: openrouter/openai/gpt-4o-mini , gemini/gemini-1.5-flash
HARNESS_LLM_MODEL=openrouter/openai/gpt-4o-mini
